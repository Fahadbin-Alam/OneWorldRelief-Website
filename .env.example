# Copy this file to `.env` when you want to customize local Docker settings.

# Used to sign login tokens in the FastAPI app.
SECRET_KEY=change-me-for-real-use

# Inside Docker, this path points at the mounted volume so SQLite data survives rebuilds.
DB_PATH=/app/data/app.db

# One World Relief payment settings.
# Use your Stripe Dashboard keys. Keep real secret keys out of Git.
OWR_STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
OWR_STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
OWR_PUBLIC_SITE_URL=https://one-world-relief.org
OWR_SUCCESS_URL=http://localhost:8000/charity/thank-you
OWR_CANCEL_URL=http://localhost:8000/charity/cancelled

# Optional Google Sheets donation log settings.
# Share the spreadsheet with the service account email before enabling this.
OWR_GOOGLE_SHEET_ID=1VeJ6gmU4o6iOq-ky1FeW_QSt6K36TJZs9_1ItLaBkKY
OWR_GOOGLE_SHEET_TAB=Donations (2026)
OWR_GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
OWR_GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-with-service-account-private-key\n-----END PRIVATE KEY-----\n"
# Alternative for Cloudflare: store the full service account JSON in this secret.
OWR_GOOGLE_SERVICE_ACCOUNT_JSON={"client_email":"your-service-account@your-project.iam.gserviceaccount.com","private_key":"-----BEGIN PRIVATE KEY-----\nreplace-with-service-account-private-key\n-----END PRIVATE KEY-----\n"}

# Required for custom OneWorld Relief receipt emails.
OWR_RESEND_API_KEY=re_your_resend_api_key
OWR_RECEIPT_FROM_EMAIL=OneWorld Relief <receipts@one-world-relief.org>
OWR_RECEIPT_REPLY_TO=Oneworldrelief.fma@gmail.com

# Optional PayPal settings if you want PayPal enabled.
OWR_PAYPAL_CLIENT_ID=
OWR_PAYPAL_CLIENT_SECRET=
OWR_PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Optional admin key for donation reports and receipt lookup endpoints.
OWR_ADMIN_API_KEY=change-me-for-admin-reports
